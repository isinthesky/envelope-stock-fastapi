# ============================================
# KIS Strategy & Alert Server - 환경 변수 설정
# ============================================

# 애플리케이션 설정
APP_NAME="KIS Strategy & Alert Server"
APP_VERSION="0.1.0"
ENV=development  # development, staging, production
DEBUG=true

# 서버 설정
HOST=0.0.0.0
PORT=8000

# ============================================
# Docker Compose 설정
# ============================================
# PostgreSQL 설정 (Docker)
POSTGRES_USER=kis_user
POSTGRES_PASSWORD=your_secure_password_here  # 반드시 변경하세요!
POSTGRES_DB=kis_trading
POSTGRES_PORT=10122

# Redis 설정 (Docker)
REDIS_PORT=10123
REDIS_PASSWORD=  # 선택사항: 비밀번호 설정 시 입력

# API 서버 포트 (외부 노출)
API_PORT=10131

# ============================================
# 로컬 개발 환경 설정
# ============================================
# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://kis_user:kis_password@localhost:5434/kis_trading
DATABASE_ECHO=false  # SQLAlchemy 쿼리 로그 출력 (개발 시 true)

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# 캐시 TTL (초)
CACHE_TTL_MARKET_DATA=5      # 시세 데이터 (5초)
CACHE_TTL_ACCOUNT=30         # 계좌 정보 (30초)
CACHE_TTL_TOKEN=86400        # 토큰 (24시간)

# KIS API 설정 (실전투자)
KIS_APP_KEY=your_real_app_key_here
KIS_APP_SECRET=your_real_app_secret_here
KIS_ACCOUNT_NO=12345678  # 8자리 계좌번호
KIS_PRODUCT_CODE=01      # 01: 종합계좌, 03: 선물옵션, 08: 해외선물옵션
KIS_HTS_ID=your_hts_id

# KIS API 설정 (모의투자)
KIS_PAPER_APP_KEY=your_paper_app_key_here
KIS_PAPER_APP_SECRET=your_paper_app_secret_here
KIS_PAPER_ACCOUNT_NO=11111111
KIS_PAPER_HTS_ID=your_hts_id

# KIS API URL
KIS_PROD_URL=https://openapi.koreainvestment.com:9443
KIS_VPS_URL=https://openapivts.koreainvestment.com:29443
KIS_PROD_WS_URL=ws://ops.koreainvestment.com:21000
KIS_VPS_WS_URL=ws://ops.koreainvestment.com:31000

# KIS API Rate Limit
KIS_API_RATE_LIMIT=20        # 초당 호출 제한 (Rate Limit 윈도우당 허용 호출 수, 기본 윈도우 1초)
KIS_API_RETRY_COUNT=3        # 실패 시 재시도 횟수
KIS_API_TIMEOUT=10           # API 호출 타임아웃 (초)
KIS_API_RATE_LIMIT_MAX_RETRIES=3             # EGW00201(초당 거래건수 초과) 지수 백오프 재시도 최대 횟수 (회)
KIS_API_RATE_LIMIT_BACKOFF_BASE_SECONDS=0.5  # EGW00201 재시도 백오프 기본 대기 (초, 0.5→1.0→2.0으로 배증)
KIS_API_RATE_MIN_INTERVAL_MS=0               # KIS REST 연속 호출 간 최소 간격 (ms, 0=window/capacity로 자동 산출)
SCAN_CONCURRENCY_LIMIT=5     # 스캔 동시 처리 수 (골든크로스/MA5)

# 자동매매 설정
TRADING_ENVIRONMENT=vps      # prod: 실전투자, vps: 모의투자
AUTO_REAUTH=true             # 토큰 자동 갱신
SMART_SLEEP=0.1              # API 호출 간격 (초)

# 리스크 관리
RISK_DAILY_LOSS_LIMIT=1000000     # 일일 최대 손실 한도 (원)
RISK_MAX_POSITIONS=10             # 최대 보유 종목 수
RISK_MAX_ORDER_AMOUNT=10000000    # 단일 주문 최대 금액 (원)

# JWT 인증 (추후 구현)
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 설정
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# 로깅 설정
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/kis_trading.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# 대시보드 설정
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH_INTERVAL=5  # 초

# WebSocket 설정
WS_MAX_CONNECTIONS=100
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# 개발 도구
UVICORN_RELOAD=true
UVICORN_WORKERS=1

# ============================================
# Telegram 알림 설정
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=true

# Telegram notification control (매수/매도 알림 스케줄러 별도 제어)
# BUY_NOTIFICATION_ENABLED=true   # 11:30/14:30 골든크로스 매수 추천
# SELL_NOTIFICATION_ENABLED=false # 09:30/12:30 매도 신호 (제거됨)
BUY_NOTIFICATION_ENABLED=true
SELL_NOTIFICATION_ENABLED=false

# 매수 전략(Fear Buy / GC) 설정
GC_REQUIRE_RSI_OVERSOLD=false   # [#A] GC 후보에 RSI 과매도 요구(GC+RSI<=임계). false=기존 라이브 동작
GC_RSI_THRESHOLD=40.0
FEAR_BUY_WINDOW_ENABLED=true    # [#3] 시장 공포 발생 후 개별 과매도 진입 허용(윈도우)
FEAR_BUY_WINDOW_DAYS=7          # 공포 트리거 후 진입 허용 거래일 수(N)
FEAR_BUY_RSI_THRESHOLD=30.0     # Fear Buy 개별 과매도 RSI 임계값
FEAR_BUY_NOTIFY_ENABLED=false   # [#2/#3] fear-buy를 추천/Telegram 알림에 포함(opt-in, 라이브 노출)
# 시장 레짐 필터 (추세추종 골든크로스 진입 게이트)
# walk-forward A/B(reports/walk_forward_regime_ab_20260802): adx=유일 Sharpe 양전(+0.154)·chop 잠식 제거(-2.4%→+7.5%)·DSR 최고,
#   ma200 단독=최악(Sharpe -0.66). ⚠️ 전 변형 여전히 NO-GO(Sharpe<1.0)이므로 라이브 검증(paper-trade) 목적으로만 켤 것.
GC_REGIME_FILTER_ENABLED=true   # [regime] 상승레짐일 때만 골든크로스 진입(권장 ON, A/B 근거). OFF면 kill-switch
GC_REGIME_MODE=adx              # 레짐 방식: adx(권장,chop회피/유일 양전)|ma(A/B최악,하위호환)|ma_adx(방어특화,MDD최소)
GC_REGIME_MA=200                # MA 레짐 판정용 이동평균 기간(일)
GC_REGIME_ADX_PERIOD=14         # ADX 추세강도 판정 기간(일)
GC_REGIME_ADX_MIN=20.0          # ADX 최소 임계(이상이면 추세 有 → 진입 허용)
GC_REGIME_BENCHMARK=069500      # 레짐 기준 벤치(실 OHLC 필요, ADX용). 기본 KODEX200
# ETF 유니버스 전환 (개별종목 중단 → 장수 ETF 추세추종)
# ETF 전환 시 아래 4종을 켠다: ETF-only 유니버스 + MA50/200 + 레짐필터
ETF_UNIVERSE_ENABLED=false      # [ETF] true면 refresh_universe가 개별주 대신 ETF만 시드(market=ETF). 기본 유니버스=장수 48종+TIGER 전종목(레버리지·원자재·통화 제외) 221종. 이 플래그는 /page 공개 스캔(GET /scan-capabilities)에도 동일하게 적용되어 공개 스캔도 ETF-only로 제한된다. false로 되돌려도 과거 비활성 KOSPI/KOSDAQ 행은 자동 복구되지 않으므로(재시드는 기존 symbol을 건너뜀) 개별주 모드 복귀에는 별도 backfill/reactivation + refresh 검증 절차가 필요하다
GC_SHORT_MA_PERIOD=55           # [ETF] 골든크로스 단기 MA(ETF 전환 시 50 권장)
GC_LONG_MA_PERIOD=165           # [ETF] 골든크로스 장기 MA(ETF 전환 시 200 권장)
# 매도 손절/레짐 설정
SELL_REGIME_AWARE_ENABLED=false # [#8 defer] 매도 시장 레짐 반영(하드 손절은 항상 적용)
STRATEGY_LIVE_TRADING_ENABLED=false  # 실주문 마스터 킬스위치. 검증 후에만 true
SELL_TREND_STOP_PCT=0.15        # [#7] MA165 추세 이탈 손절 비율

# ============================================
# 공개 전략 포털 (/page/) 설정
# ============================================
PUBLIC_STRATEGY_SCAN_LIMIT=100                    # 공개 스캔 종목 상한 (1~500)
PUBLIC_STRATEGY_SCAN_MAX_CONCURRENT=2             # 공개 스캔 내부 동시성 (1~5)
PUBLIC_STRATEGY_SCAN_COOLDOWN_SECONDS=300         # IP별 재실행 대기 (초, ≥30)
PUBLIC_STRATEGY_SCAN_LOCK_SECONDS=180             # 전역 실행 락 안전 만료 (초, ≥30)
PUBLIC_STRATEGY_RECOMMENDATION_TTL_SECONDS=172800 # 추천 스냅샷 보관 (초, ≥3600 / 48시간)
PUBLIC_SELL_ANALYSIS_CACHE_TTL_SECONDS=300        # 공개 매도 분석 종목별 캐시 (초, ≥30)
PUBLIC_SELL_ANALYSIS_COOLDOWN_SECONDS=60         # 공개 매도 분석 IP별 재실행 대기 (초, ≥10)
PUBLIC_SELL_ANALYSIS_LOCK_SECONDS=180            # 공개 매도 분석 전역 실행 락 (초, ≥30)

# ============================================
# DART API 설정 (금융감독원 전자공시시스템)
# ============================================
DART_OPEN_API_KEY=your_dart_open_api_key_here
